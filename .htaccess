Options -Indexes
RewriteEngine On

RewriteRule ^config(?:\.example)?\.php$ - [F,L]
RewriteRule ^(?:lib|sql|tests|storage|pages)(?:/|$) - [F,L]

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
